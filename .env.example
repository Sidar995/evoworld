# Replace YOUR_PASSWORD locally. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/evoworld
PORT=3000

# Local defaults; use dashboard secrets for hosting instead of this file.
HOST=127.0.0.1
AUTH_MODE=local

# Hosted dashboard settings (private values are placeholders only):
# NODE_ENV=production
# HOST=0.0.0.0
# AUTH_MODE=owner
# PUBLIC_ORIGIN=https://your-service.onrender.com
# OWNER_PASSWORD=<a unique private password of at least 16 characters>
# DATABASE_URL=<Neon connection string with required TLS parameters>
